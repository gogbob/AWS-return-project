# Local demo configuration for the ALDO Returns Agent backend.

# Use the mock LLM so the return chat works without AWS Bedrock credentials.
LLM_MOCK=true

# Pin the featured demo product to a clean style name present in the dataset.
DEMO_ITEM_NAME=Quincey

# Database (absolute path so it resolves regardless of working directory).
DATABASE_URL=sqlite:///c:/AWS/AWS-return-project/backend/aldo_returns.db
