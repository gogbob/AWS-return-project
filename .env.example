# ── LLM / Model ──────────────────────────────────────────────────────────────
LLM_MOCK=false
MODEL_PROVIDER=bedrock
MODEL_ID=
AWS_REGION=

# ── Item grouping key ─────────────────────────────────────────────────────────
# "name" = orderitem_product_name (style-level, recommended)
# "sku"  = variant-level (use only for size/colour analysis)
ITEM_KEY=name

# ── Loyalty simulation ────────────────────────────────────────────────────────
LOYALTY_SEED=42
HIGH_LOYALTY_THRESHOLD=70

# ── Triage / scoring thresholds ───────────────────────────────────────────────
SUSPICION_THRESHOLD=0.50

# ── Value thresholds (CAD) ────────────────────────────────────────────────────
HIGH_VALUE_CAD=150
SHIPPING_FEE_CAD=7.99

# ── Statistical flagging parameters ──────────────────────────────────────────
# Minimum resolved returns required before a baseline is computed
MIN_RETURNS_BASELINE=30
# Minimum returns for a customer / item to be flagged
MIN_RETURNS_FLAG=30
# Minimum unique customers required before an item-level flag fires
MIN_CUSTOMERS_FLAG=20
# Minimum absolute excess return-rate above baseline to flag
FLAG_MIN_EXCESS=0.15
# Minimum ratio of observed / expected return rate to flag
FLAG_MIN_RATIO=1.5
# Adjusted p-value threshold (Benjamini-Hochberg) for statistical flags
FLAG_P_ADJ=0.01

# ── Size-guidance automation ──────────────────────────────────────────────────
AUTO_APPLY_SIZE_GUIDANCE=false

# ── Demo / testing ────────────────────────────────────────────────────────────
# Set to a product name to pre-populate the demo UI
DEMO_ITEM_NAME=
